PORT=3000

NODE_ENV=development

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

PUBLIC_BASE_URL=
MEDIA_STREAM_WS_URL=
# Incoming Twilio Voice webhook: {PUBLIC_BASE_URL}/voice
# Outbound answer TwiML (set by API calls.create): {PUBLIC_BASE_URL}/voice/outbound

# Deprecated — ConversationRelay phone path retired (Gemini Live + Media Streams).
# CONVERSATION_RELAY_WS_URL=

MONGODB_URI=mongodb://127.0.0.1:27017/twilio_ai_voice_agent

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Phase 1 default: Gemini 3.8 Live (low-latency). A/B fallback:
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede
# Knowledge RAG embeddings (do not use text-embedding-004).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=768
# KNOWLEDGE_MIN_SCORE=0
# Retrieved context defaults (Phase 1): smaller slice for lower Live latency.
KNOWLEDGE_TOP_K=3
KNOWLEDGE_MAX_CHARS=3000
# Benchmark: LATENCY_* lines + KNOWLEDGE_SEARCH path=cache|lexical|semantic
VOICE_LANGUAGE=en-US
# Optional health/display label only — Live identity comes from Agent.name in Mongo
CHATBOT_NAME=

# Gemini Live VAD (phone barge-in). HIGH/LOW or full SDK enums accepted.
# silence 300 + end HIGH = snappier turns; raise silence to 400–500 if mid-sentence cutoffs.
VAD_START_SENSITIVITY=LOW
VAD_END_SENSITIVITY=HIGH
VAD_PREFIX_PADDING_MS=150
VAD_SILENCE_DURATION_MS=500
# Barge-in confirm window / Twilio clear debounce (ms)
BARGE_IN_CONFIRM_MS=480
BARGE_IN_CLEAR_DEBOUNCE_MS=500
# Optional Gemini Live PCM input batching (ms). 0 = immediate send (default).
# Experimental: 100 ≈ batch ~100 ms of PCM16k before sendRealtimeInput.
# Do not enable in production until controlled ASR tests show improvement.
# GEMINI_PCM_BATCH_MS=0

DASHBOARD_WS_URL=
SKIP_TWILIO_SIGNATURE=false

# Option C classic pipeline (leave unset or live to keep Gemini Live).
# VOICE_PIPELINE=classic
# DEEPGRAM_API_KEY=
# DEEPGRAM_FLUX_MODEL=flux-general-en
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# OUTBOUND_AMBIENCE_ENABLED=false
# OUTBOUND_AMBIENCE_GAIN=0.08
